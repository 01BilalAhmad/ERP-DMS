// Distribution ERP - Multi-Company Distribution System
// 4 Companies | 1200 Shops | 9 Order Bookers | Single Warehouse (company-wise sections)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== AUTH & USERS =====================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String // hashed
  role          String   @default("ORDER_BOOKER") // SUPER_ADMIN | COMPANY_MANAGER | ORDER_BOOKER | ACCOUNTS | WAREHOUSE | VIEWER
  phone         String?
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booker        OrderBooker?
  orders        Order[]      @relation("OrderCreatedBy")
  payments      Payment[]    @relation("PaymentReceivedBy")
  approvals     Order[]      @relation("OrderApprovedBy")
  batchesCreated  OrderBatch[] @relation("BatchCreatedBy")
  batchesApproved  OrderBatch[] @relation("BatchApprovedBy")
}

// ===================== MULTI-CURRENCY =====================
model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // PKR, USD, EUR, AED
  name      String
  symbol    String
  rate      Float    @default(1) // rate against base (PKR). PKR = 1
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== COMPANIES =====================
model Company {
  id              String   @id @default(cuid())
  code            String   @unique // COMP-A, COMP-B
  name            String
  address         String?
  phone           String?
  ntn             String?  // National Tax Number
  strn            String?  // Sales Tax Registration Number
  taxType         String   @default("FILER") // FILER | NON_FILER
  defaultCurrency String   @default("PKR")
  salesTaxRate    Float    @default(17) // % sales tax
  filerTaxRate    Float    @default(4.5) // % withholding for filer
  nonFilerTaxRate Float    @default(8) // % withholding for non-filer
  furtherTaxRate  Float    @default(3) // % further tax for non-filer on sales tax
  status          String   @default("ACTIVE")
  logo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections       WarehouseSection[]
  categories     Category[]
  products       Product[]
  schemes        Scheme[]
  orders         Order[]
  batches        OrderBatch[]
  invoices       Invoice[]
  payments       Payment[]
  ledgerEntries  Ledger[]
  bookerMaps     BookerCompanyMapping[]
  shopLinks      ShopCompanyLink[]
  bookers        BookerShopAssignment[]
}

// ===================== WAREHOUSE (Single, company-wise sections) =====================
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections WarehouseSection[]
}

model WarehouseSection {
  id           String   @id @default(cuid())
  warehouseId  String
  companyId    String
  name         String
  code         String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks    Stock[]
  movements StockMovement[]
}

// ===================== SHOPS (1200 retailers) =====================
model Shop {
  id            String   @id @default(cuid())
  code          String   @unique // SHOP-0001
  name          String
  ownerName     String?
  phone         String?
  address       String?
  gpsLat        Float?
  gpsLng        Float?
  shopClass     String   @default("C") // A | B | C
  taxType       String   @default("NON_FILER") // FILER | NON_FILER
  ntn           String?
  strn          String?
  visitDay      String?  // MON, TUE, WED...
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLISTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyLinks  ShopCompanyLink[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries Ledger[]
  assignments   BookerShopAssignment[]
}

// Shop can buy from multiple companies - separate credit limit & outstanding per company
model ShopCompanyLink {
  id               String  @id @default(cuid())
  shopId           String
  companyId        String
  creditLimit      Float   @default(0) // 0 = unlimited
  outstandingBalance Float  @default(0)
  status           String  @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([shopId, companyId])
}

// ===================== ORDER BOOKERS (9, each maps to 2 companies) =====================
model OrderBooker {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeCode String   @unique // OB-001
  name         String
  phone        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyMaps  BookerCompanyMapping[]
  shopAssign   BookerShopAssignment[]
  orders       Order[]  @relation("OrderBooker")
  batches      OrderBatch[] @relation("BatchBooker")
}

model BookerCompanyMapping {
  id        String   @id @default(cuid())
  bookerId  String
  companyId String
  createdAt DateTime @default(now())

  booker  OrderBooker @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([bookerId, companyId])
}

model BookerShopAssignment {
  id        String   @id @default(cuid())
  bookerId  String
  shopId    String
  companyId String
  routeDay  String?  // MON, TUE...
  sequence  Int      @default(0)
  createdAt DateTime @default(now())

  booker  OrderBooker @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([bookerId, shopId, companyId])
}

// ===================== PRODUCTS (per company, separate catalogs) =====================
model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  categoryId    String?
  code          String   // SKU code, unique within company
  name          String
  description   String?
  packSize      String?  // e.g. "12x500ml"
  unit          String   @default("CTN") // CTN | DOZ | PCS | BOX
  piecesPerPack Float    @default(1) // for unit conversion
  tradePrice    Float    // price to shop
  retailerPrice Float?   // MRP
  costPrice     Float    @default(0)
  taxRate       Float    @default(17) // product-level sales tax %
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks    Stock[]
  schemes   Scheme[]
  orderItems OrderItem[]
  movements StockMovement[]

  @@unique([companyId, code])
}

model Scheme {
  id          String   @id @default(cuid())
  companyId   String
  productId   String
  name        String
  type        String   // DISCOUNT_PCT | DISCOUNT_AMOUNT | BONUS_QTY
  value       Float    // % or amount or bonus qty
  minQty      Float    @default(0)
  startDate   DateTime
  endDate     DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ===================== STOCK =====================
model Stock {
  id            String   @id @default(cuid())
  sectionId     String
  productId     String
  quantity      Float    @default(0)
  batchNo       String?
  expiryDate    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  section WarehouseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId, batchNo])
}

model StockMovement {
  id        String   @id @default(cuid())
  sectionId String
  productId String
  type      String   // OPENING | IN | OUT | ADJUST | TRANSFER | RETURN
  quantity  Float    // +ve for in, -ve for out
  balance   Float
  reference String?  // order id, adjustment id, etc
  notes     String?
  createdAt DateTime @default(now())

  section  WarehouseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ===================== ORDERS =====================
// Order Batch: groups multiple orders for bulk processing
// (booker punches 10 orders → 1 batch → supervisor approves all → 1 pick list → 1 manifest)
model OrderBatch {
  id            String   @id @default(cuid())
  batchNo       String   @unique // BAT-000001
  companyId     String
  bookerId      String?
  batchDate     DateTime @default(now())
  status        String   @default("OPEN") // OPEN | APPROVED | PICKED | DISPATCHED | DELIVERED | CLOSED | CANCELLED
  notes         String?

  // Batch summary totals (sum across all orders)
  totalOrders   Int      @default(0)
  totalShops    Int      @default(0)
  totalItems    Int      @default(0) // unique line items
  totalQuantity Float    @default(0) // total units
  grandTotal    Float    @default(0)

  approvedById  String?
  approvedAt    DateTime?
  pickedAt      DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  closedAt      DateTime?

  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  booker     OrderBooker?  @relation("BatchBooker", fields: [bookerId], references: [id])
  createdBy  User          @relation("BatchCreatedBy", fields: [createdById], references: [id])
  approvedBy User?         @relation("BatchApprovedBy", fields: [approvedById], references: [id])
  orders     Order[]
}

model Order {
  id              String   @id @default(cuid())
  orderNo         String   @unique // ORD-000001
  batchId         String?  // linked to OrderBatch (null = standalone)
  companyId       String
  shopId          String
  bookerId        String?
  status          String   @default("PENDING") // DRAFT | PENDING | APPROVED | PICKED | DISPATCHED | DELIVERED | CANCELLED
  orderDate       DateTime @default(now())
  deliveryDate    DateTime?

  // Currency
  currency        String   @default("PKR")
  currencyRate    Float    @default(1)

  // Totals (in order currency)
  subtotal        Float    @default(0)
  schemeDiscount  Float    @default(0)
  manualDiscount  Float    @default(0)
  totalDiscount   Float    @default(0)
  taxableAmount   Float    @default(0) // subtotal - discounts
  salesTax        Float    @default(0)
  furtherTax      Float    @default(0) // for non-filer shops
  withholdingTax  Float    @default(0) // filer/non-filer withholding
  grandTotal      Float    @default(0)
  previousBalance Float    @default(0) // shop's outstanding captured at order creation (snapshot)
  totalPayable    Float    @default(0) // grandTotal + previousBalance

  // Warnings (NOT blocking)
  creditLimitExceeded Boolean @default(false)
  stockShortage       Boolean @default(false)
  warnings            String? // JSON string of warning messages

  notes           String?
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batch      OrderBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  company    Company   @relation(fields: [companyId], references: [id])
  shop       Shop      @relation(fields: [shopId], references: [id])
  booker     OrderBooker? @relation("OrderBooker", fields: [bookerId], references: [id])
  createdBy  User      @relation("OrderCreatedBy", fields: [createdById], references: [id])
  approvedBy User?     @relation("OrderApprovedBy", fields: [approvedById], references: [id])
  items      OrderItem[]
  invoice    Invoice?
  ledger     Ledger?
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Float
  unitPrice   Float   // trade price
  discountPct Float   @default(0) // scheme/manual %
  discountAmt Float   @default(0)
  taxRate     Float   @default(17)
  taxAmount   Float   @default(0)
  lineTotal   Float   @default(0) // qty*price - discount + tax
  schemeApplied String? // description of applied scheme

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

// ===================== INVOICES =====================
model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique // INV-000001
  orderId     String   @unique
  companyId   String
  shopId      String
  invoiceDate DateTime @default(now())
  dueDate     DateTime?

  currency     String  @default("PKR")
  currencyRate Float   @default(1)
  subtotal     Float   @default(0)
  totalDiscount Float  @default(0)
  salesTax     Float   @default(0)
  furtherTax   Float   @default(0)
  withholdingTax Float @default(0)
  grandTotal   Float   @default(0)
  previousBalance Float @default(0) // carried from order snapshot
  totalPayable Float @default(0) // grandTotal + previousBalance
  paidAmount   Float   @default(0)
  balance      Float   @default(0)
  status       String  @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  createdAt    DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])
  ledger  Ledger?
}

// ===================== LEDGER (per company per shop) =====================
model Ledger {
  id          String   @id @default(cuid())
  companyId   String
  shopId      String
  orderId     String?  @unique
  invoiceId   String?  @unique
  paymentId   String?  @unique
  entryType   String   // DEBIT (invoice) | CREDIT (payment)
  amount      Float    // in company default currency
  balance     Float    @default(0)
  reference   String?  // invoice no / payment no
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  shop    Shop     @relation(fields: [shopId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
}

// ===================== PAYMENTS =====================
model Payment {
  id            String   @id @default(cuid())
  paymentNo     String   @unique // PAY-000001
  companyId     String
  shopId        String
  amount        Float    // in company default currency
  paymentMode   String   // CASH | CHEQUE | TRANSFER | ONLINE
  currency      String   @default("PKR")
  currencyRate  Float    @default(1)
  referenceNo   String?  // cheque no, txn id
  bankName      String?
  paymentDate   DateTime @default(now())
  status        String   @default("RECEIVED") // RECEIVED | CLEARED | BOUNCED
  receivedById  String
  notes         String?
  createdAt     DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id])
  shop       Shop    @relation(fields: [shopId], references: [id])
  receivedBy User    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  ledger     Ledger?
}
